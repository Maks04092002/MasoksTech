@model MasoksTech.Web.Models.LoginViewModel
@{
    Layout = null; // No usamos el menú general para la pantalla de login
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>MASOKS TECH - Login</title>
    <!-- Bootstrap CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <!-- Bootstrap Icons para un look más moderno -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <style>
            :root {
                --bg-dark: #070a13; /* Fondo oscuro profundo gamer */
                --card-bg: rgba(15, 23, 42, 0.75); /* Vidrio oscuro semi-transparente */
                --neon-cyan: #06b6d4; /* Azul cian brillante */
                --neon-blue: #3b82f6; /* Azul eléctrico */
                --text-gray: #94a3b8; /* Texto secundario legible */
            }

            body {
                background-color: var(--bg-dark);
                /* Fondo con dos esferas de luz de neón difuminadas de fondo */
                background-image: radial-gradient(circle at 10% 20%, rgba(6, 182, 212, 0.15) 0%, transparent 40%), radial-gradient(circle at 90% 80%, rgba(59, 130, 246, 0.18) 0%, transparent 45%);
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
                display: flex;
                align-items: center;
                justify-content: center;
                height: 100vh;
                margin: 0;
                overflow: hidden;
            }

            /* Tarjeta con efecto Glassmorphism (Vidrio) */
            .login-card {
                background: var(--card-bg);
                backdrop-filter: blur(16px);
                -webkit-backdrop-filter: blur(16px);
                padding: 3rem 2.5rem;
                border-radius: 20px;
                border: 1px solid rgba(255, 255, 255, 0.08);
                /* Sombra profunda + brillo de neón exterior suave */
                box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5), 0 0 40px rgba(6, 182, 212, 0.1);
                width: 100%;
                max-width: 420px;
                transition: all 0.4s ease;
            }

                .login-card:hover {
                    border-color: rgba(6, 182, 212, 0.25);
                    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.6), 0 0 50px rgba(6, 182, 212, 0.2);
                }

            /* Título con Gradiente de Neón */
            .brand-title {
                background: linear-gradient(135deg, #fff 30%, var(--neon-cyan) 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                font-weight: 900;
                letter-spacing: 2px;
                text-align: center;
                margin-bottom: 0.2rem;
                font-size: 2.2rem;
                text-shadow: 0 0 30px rgba(6, 182, 212, 0.2);
            }

            .brand-subtitle {
                color: var(--text-gray);
                font-size: 0.9rem;
                text-align: center;
                margin-bottom: 2.5rem;
                letter-spacing: 1px;
            }

            /* Inputs Modernos Estilo Cyber */
            .form-label {
                color: #cbd5e1;
                font-weight: 600;
                font-size: 0.8rem;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .form-control {
                background-color: rgba(15, 23, 42, 0.6) !important;
                border: 1px solid rgba(255, 255, 255, 0.1);
                color: #fff !important;
                padding: 0.75rem 1rem;
                border-radius: 10px;
                transition: all 0.3s ease;
            }

                .form-control::placeholder {
                    color: #4b5563;
                }

                /* Foco del Input con Brillo */
                .form-control:focus {
                    background-color: rgba(15, 23, 42, 0.8) !important;
                    border-color: var(--neon-cyan);
                    box-shadow: 0 0 15px rgba(6, 182, 212, 0.3);
                    outline: none;
                }

            /* Botón Gamer con Degradado Activo */
            .btn-custom {
                background: linear-gradient(135deg, #0284c7, var(--neon-blue));
                color: white;
                font-weight: 700;
                width: 100%;
                padding: 0.85rem;
                border-radius: 10px;
                border: none;
                letter-spacing: 1px;
                text-transform: uppercase;
                box-shadow: 0 4px 20px rgba(59, 130, 246, 0.3);
                transition: all 0.3s ease;
            }

                .btn-custom:hover {
                    background: linear-gradient(135deg, var(--neon-cyan), #2563eb);
                    box-shadow: 0 0 25px rgba(6, 182, 212, 0.5);
                    transform: translateY(-2px);
                    color: white;
                }

                .btn-custom:active {
                    transform: translateY(1px);
                }

            /* Enlaces de Cuenta */
            .register-link {
                color: var(--neon-cyan);
                font-weight: 600;
                text-decoration: none;
                transition: all 0.3s ease;
            }

                .register-link:hover {
                    color: #22d3ee;
                    text-shadow: 0 0 10px rgba(6, 182, 212, 0.4);
                }

            /* Mensajes de Validación Personalizados */
            .text-danger {
                color: #f43f5e !important; /* Rojo neón suave */
                font-weight: 500;
            }

            /* Alertas Personalizadas */
            .alert-custom-success {
                background-color: rgba(16, 185, 129, 0.15);
                border: 1px solid rgba(16, 185, 129, 0.3);
                color: #34d399;
                border-radius: 10px;
            }

            .alert-custom-danger {
                background-color: rgba(244, 63, 94, 0.15);
                border: 1px solid rgba(244, 63, 94, 0.3);
                color: #fb7185;
                border-radius: 10px;
            }
    </style>
</head>
<body>

    <div class="login-card">
        <h1 class="brand-title">MASOKS TECH</h1>
        <p class="brand-subtitle">Portal de Administración</p>

        <!-- Alerta de éxito de registro -->
        @if (TempData["SuccessRegister"] != null)
        {
            <div class="alert alert-custom-success text-center py-2 mb-4" style="font-size: 0.85rem;">
                <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessRegister"]
            </div>
        }

        <form asp-action="Login" method="post">
            <!-- Resumen de errores de credenciales -->
            <div asp-validation-summary="ModelOnly" class="alert alert-custom-danger text-center py-2 mb-4" style="font-size: 0.85rem;"></div>

            <div class="mb-3">
                <label asp-for="Correo" class="form-label"><i class="bi bi-envelope-fill me-2"></i>Correo Electrónico</label>
                <input asp-for="Correo" class="form-control" placeholder="ejemplo@masokstech.com" autocomplete="off" />
                <span asp-validation-for="Correo" class="text-danger small mt-1 d-block"></span>
            </div>

            <div class="mb-4">
                <label asp-for="Password" class="form-label"><i class="bi bi-lock-fill me-2"></i>Contraseña</label>
                <input asp-for="Password" type="password" class="form-control" placeholder="••••••••" />
                <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
            </div>

            <button type="submit" class="btn btn-custom">
                Iniciar Sesión <i class="bi bi-box-arrow-in-right ms-1"></i>
            </button>
        </form>

        <!-- Registro Link -->
        <div class="text-center mt-4">
            <p class="mb-0" style="color: var(--text-gray); font-size: 0.85rem;">
                ¿No tienes una cuenta? <a href="@Url.Action("Register", "Account")" class="register-link">Registrarse aquí</a>
            </p>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>