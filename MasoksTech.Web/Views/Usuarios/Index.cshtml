@model List<MasoksTech.Web.Models.UsuarioItem>
@{
    ViewData["Title"] = "Gestión de Usuarios";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-3 bg-dark text-white p-4 rounded-3 min-vh-100">
            <h3 class="text-center mb-4 font-weight-bold">MASOKS TECH</h3>
            <p class="text-muted text-center small">Portal de Administración</p>
            <hr class="bg-secondary" />
            <ul class="nav flex-column">
                <li class="nav-item mb-2">
                    <a class="nav-link text-white-50" href="@Url.Action("Index", "Dashboard")"><i class="bi bi-speedometer2"></i> Panel Principal</a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white-50" href="@Url.Action("Index", "Inventario")"><i class="bi bi-box-seam"></i> Inventario</a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white active fw-bold" href="@Url.Action("Index", "Usuarios")"><i class="bi bi-people"></i> Usuarios</a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white-50" href="@Url.Action("Login", "Account")"><i class="bi bi-box-arrow-left"></i> Salir</a>
                </li>
            </ul>
        </div>

        <div class="col-md-9 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-dark">Gestión de Usuarios</h2>
                <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#modalAgregarUsuario">
                    + Nuevo Usuario
                </button>
            </div>

            <div class="card border-0 shadow-sm p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nombre</th>
                                <th>Email</th>
                                <th>Rol</th>
                                <th>Estado</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                    <td>@user.Id</td>
                                    <td><strong>@user.Nombre</strong></td>
                                    <td>@user.Correo</td>
                                    <td><span class="badge bg-primary">@user.Rol</span></td>
                                    <td>
                                        @if (user.Activo)
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Inactivo</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <form asp-action="Eliminar" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@user.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Seguro que deseas eliminar este usuario?')">
                                                Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalAgregarUsuario" tabindex="-1" aria-labelledby="modalUserLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalUserLabel">Registrar Nuevo Usuario</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Agregar" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre Completo</label>
                        <input type="text" name="nombre" class="form-control" required placeholder="Ejem: Carlos Mendoza" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Correo Electrónico</label>
                        <input type="email" name="correo" class="form-control" required placeholder="carlos@masokstech.com" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Rol del Sistema</label>
                        <select name="rol" class="form-select">
                            <option value="Administrador">Administrador</option>
                            <option value="Vendedor">Vendedor</option>
                            <option value="Soporte">Soporte</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Estado Inicial</label>
                        <select name="activo" class="form-select">
                            <option value="true">Activo</option>
                            <option value="false">Inactivo</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-success">Guardar Usuario</button>
                </div>
            </form>
        </div>
    </div>
</div>