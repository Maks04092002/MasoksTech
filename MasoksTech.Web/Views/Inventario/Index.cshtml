@model List<MasoksTech.Web.Models.InventarioItem>
@{
    ViewData["Title"] = "Gestión de Inventario";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-md-3 bg-dark text-white p-4 rounded-3 min-vh-100">
            <h3 class="text-center mb-4 font-weight-bold">MASOKS TECH</h3>
            <p class="text-muted text-center small">Portal de Administración</p>
            <hr class="bg-secondary" />
            <ul class="nav flex-column">
                <li class="nav-item mb-2">
                    <a class="nav-link text-white-50" href="@Url.Action("Index", "Dashboard")"><i class="bi bi-speedometer2"></i> Panel Principal</a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white active fw-bold" href="@Url.Action("Index", "Inventario")"><i class="bi bi-box-seam"></i> Inventario</a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white-50" href="@Url.Action("Index", "Usuarios")"><i class="bi bi-people"></i> Usuarios</a>
                </li>
                <li class="nav-item mb-2">
                    <a class="nav-link text-white-50" href="@Url.Action("Login", "Account")"><i class="bi bi-box-arrow-left"></i> Salir</a>
                </li>
            </ul>
        </div>

        <div class="col-md-9 p-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-dark">Gestión de Inventario (Accesorios)</h2>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalAgregarProducto">
                    + Agregar Producto
                </button>
            </div>

            <div class="card border-0 shadow-sm p-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th style="width: 70px;">Miniatura</th>
                                <th>Nombre</th>
                                <th>Categoría</th>
                                <th>Stock</th>
                                <th>Precio</th>
                                <th class="text-center">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.Id</td>
                                    <td>
                                        <img src="@item.ImagenUrl" class="rounded border shadow-sm" style="width: 45px; height: 45px; object-fit: cover;" alt="@item.Nombre" onerror="this.src='https://images.unsplash.com/photo-1527443224154-c4a3942d3acf?w=100&q=80';" />
                                    </td>
                                    <td><strong>@item.Nombre</strong></td>
                                    <td><span class="badge bg-secondary">@item.Categoria</span></td>
                                    <td>@item.Stock unids.</td>
                                    <td>S/ @item.Precio.ToString("F2")</td>
                                    <td class="text-center">
                                        <form asp-action="Eliminar" method="post" class="d-inline">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('¿Seguro que deseas eliminar este producto?')">
                                                Eliminar
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="modalAgregarProducto" tabindex="-1" aria-labelledby="modalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="modalLabel">Nuevo Producto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="Agregar" method="post">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Nombre del Accesorio</label>
                        <input type="text" name="nombre" class="form-control" required placeholder="Ejem: Teclado Mecánico Red" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Categoría</label>
                        <select name="categoria" class="form-select">
                            <option value="Periféricos">Periféricos</option>
                            <option value="Audio">Audio</option>
                            <option value="Componentes">Componentes</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">URL de la Imagen de referencia</label>
                        <input type="url" name="imagenUrl" class="form-control" placeholder="https://ejemplo.com/imagen.jpg" />
                        <div class="form-text small text-muted">Pega un enlace de imagen (puedes usar Unsplash) o déjalo vacío para usar una genérica.</div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Cantidad Inicial (Stock)</label>
                        <input type="number" name="stock" class="form-control" required min="1" value="10" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Precio (S/)</label>
                        <input type="number" step="0.01" name="precio" class="form-control" required min="0.1" value="49.90" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">URL de la Imagen de referencia</label>
                        <input type="url" name="imagenUrl" class="form-control" placeholder="https://ejemplo.com/imagen.jpg" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Producto</button>
                </div>
            </form>
        </div>
    </div>
</div>